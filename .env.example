NODE_ENV=development
PORT=10000
# Replace locally; in production set these in Render environment settings.
DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:5432/shlamp
ACCESS_TOKEN_SECRET=REPLACE_WITH_YOUR_EXISTING_SECRET_AT_LEAST_32_CHARACTERS
ADMIN_SETUP_KEY=REPLACE_WITH_YOUR_EXISTING_ADMIN_KEY_AT_LEAST_24_CHARACTERS
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_RETRY_GRACE_SECONDS=120
BCRYPT_ROUNDS=10
CORS_ORIGINS=*
COMMAND_TTL_SECONDS=120
PASSWORD_RESET_TOKEN_TTL_MINUTES=15
PASSWORD_RESET_DEBUG_RETURN_TOKEN=false
SHADOW_AUTH_ENABLED=false
DEVICE_CREDENTIAL_WRAPPING_KEY_VERSION=1
# Keep existing values when enabled. Never commit actual keys.
# DEVICE_CREDENTIAL_MASTER_KEY_B64=
# RESEND_API_KEY=
# PASSWORD_RESET_FROM_EMAIL=
