generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum HomeRole {
  OWNER
  ADMIN
  MEMBER
  GUEST
}

enum CommandStatus {
  PENDING
  SENT
  ACKNOWLEDGED
  FAILED
  EXPIRED
}

model User {
  id            String          @id @default(uuid()) @db.Uuid
  email         String          @unique
  passwordHash  String
  displayName   String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  ownedHomes    Home[]          @relation("HomeOwner")
  memberships   HomeMember[]
  ownedDevices  Device[]        @relation("DeviceOwner")
  refreshTokens RefreshToken[]
  commands      DeviceCommand[]
  activities    ActivityEvent[]
}

model Home {
  id         String          @id @default(uuid()) @db.Uuid
  name       String
  ownerId    String          @db.Uuid
  owner      User            @relation("HomeOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  members    HomeMember[]
  rooms      Room[]
  devices    Device[]
  activities ActivityEvent[]

  @@index([ownerId])
}

model HomeMember {
  id        String   @id @default(uuid()) @db.Uuid
  homeId    String   @db.Uuid
  userId    String   @db.Uuid
  role      HomeRole @default(MEMBER)
  createdAt DateTime @default(now())
  home      Home     @relation(fields: [homeId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([homeId, userId])
  @@index([userId])
}

model Room {
  id        String   @id @default(uuid()) @db.Uuid
  homeId    String   @db.Uuid
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  home      Home     @relation(fields: [homeId], references: [id], onDelete: Cascade)
  devices   Device[]

  @@unique([homeId, name])
  @@index([homeId])
}

model Device {
  id               String          @id @default(uuid()) @db.Uuid
  lampId           String          @unique
  displayName      String          @default("SH Lamp")
  deviceSecretHash String
  claimCodeHash    String?
  claimedAt        DateTime?
  ownerId          String?         @db.Uuid
  homeId           String?         @db.Uuid
  roomId           String?         @db.Uuid
  online           Boolean         @default(false)
  lastSeen         DateTime?
  firmwareVersion  String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  owner             User?           @relation("DeviceOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  home              Home?           @relation(fields: [homeId], references: [id], onDelete: SetNull)
  room              Room?           @relation(fields: [roomId], references: [id], onDelete: SetNull)
  state             DeviceState?
  commands          DeviceCommand[]
  activities        ActivityEvent[]

  @@index([ownerId])
  @@index([homeId])
  @@index([roomId])
}

model DeviceState {
  id             String   @id @default(uuid()) @db.Uuid
  deviceId       String   @unique @db.Uuid
  power          Boolean  @default(false)
  brightness     Int      @default(0)
  fadeMode       Int      @default(0)
  timerRemaining Int      @default(0)
  rawJson        Json?
  updatedAt      DateTime @updatedAt
  device         Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
}

model DeviceCommand {
  id             String        @id @default(uuid()) @db.Uuid
  commandId      String        @unique
  deviceId       String        @db.Uuid
  userId         String?       @db.Uuid
  action         String
  valueJson      Json?
  status         CommandStatus @default(PENDING)
  expiresAt      DateTime
  createdAt      DateTime      @default(now())
  deliveredAt    DateTime?
  acknowledgedAt DateTime?
  errorMessage   String?
  device         Device        @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([deviceId, status])
  @@index([expiresAt])
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model ActivityEvent {
  id        String   @id @default(uuid()) @db.Uuid
  type      String
  payload   Json?
  userId    String?  @db.Uuid
  deviceId  String?  @db.Uuid
  homeId    String?  @db.Uuid
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  device    Device?  @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  home      Home?    @relation(fields: [homeId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([deviceId, createdAt])
  @@index([homeId, createdAt])
}
