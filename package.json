{
  "name": "sh-lamp-cloud-render",
  "version": "0.1.0",
  "private": true,
  "description": "SH Lamp Phase 3A Render cloud proof-of-concept backend",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:render": "prisma migrate deploy && node dist/server.js",
    "db:generate": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "check": "tsc -p tsconfig.json --noEmit",
    "test:p2b": "node tools/rf7_p2b_contract_test.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "express": "5.2.1",
    "jsonwebtoken": "9.0.2",
    "ws": "8.21.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "22.15.30",
    "@types/ws": "8.18.1",
    "prisma": "6.19.3",
    "typescript": "5.8.3"
  }
}
